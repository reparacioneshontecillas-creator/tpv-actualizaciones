<!--TPV-NOTAS: Diagnóstico de la conexión de cocina: la app indica si el módulo nativo está instalado y muestra la IP de la tablet. -->
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>TPV Bar</title>
<style>
:root{--bg:#eef1f5;--card:#fff;--ink:#0f1b2d;--mut:#5b6677;--pri:#13766c;--soft:#e3eeee;--bad:#b3261e;--ok:#17722f;--fld:#eeeff1;--line:#e2e6ea;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){color-scheme:dark;--bg:#0f1720;--card:#18232f;--ink:#eaf0f6;--mut:#9aa8b8;--soft:#1f3a3d;--fld:#223040;--bad:#ff8a80;--ok:#6fdc8c;--pri:#2aa396;--line:#2a3846}}
:root[data-theme=dark]{color-scheme:dark;--bg:#0f1720;--card:#18232f;--ink:#eaf0f6;--mut:#9aa8b8;--soft:#1f3a3d;--fld:#223040;--bad:#ff8a80;--ok:#6fdc8c;--pri:#2aa396;--line:#2a3846}
*{box-sizing:border-box}html,body{margin:0}body{background:var(--bg);color:var(--ink);font:16px/1.35 system-ui,"Segoe UI",sans-serif}
header{background:linear-gradient(90deg,var(--h1,#0d3b44),var(--h2,#13766c));color:#fff;display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:12px 18px}
.br{font-size:20px;margin-right:auto}.us{opacity:.9}nav{display:flex;flex-wrap:wrap;gap:8px}
.b{border:0;border-radius:999px;padding:12px 20px;font:600 16px inherit;font-family:inherit;cursor:pointer;background:rgba(255,255,255,.18);color:#fff}
.b.on,.b.w{background:#fff;color:#0d3b44}header .b.w:not(.on){background:rgba(255,255,255,.18);color:#fff}
main{padding:18px;max-width:1300px;margin:0 auto}
.card{background:var(--card);border-radius:20px;padding:18px;box-shadow:0 2px 14px rgba(0,0,0,.07)}
.cols{display:grid;grid-template-columns:1fr 360px;gap:18px;align-items:start}@media(max-width:820px){.cols{grid-template-columns:1fr}}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.chip{border:0;border-radius:999px;padding:12px 20px;background:var(--card);color:var(--ink);font:600 16px inherit;font-family:inherit;cursor:pointer}
.chip.on{background:var(--pri);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.pc{border:0;border-top:5px solid var(--pri);background:var(--card);border-radius:16px;padding:14px;text-align:left;cursor:pointer;color:var(--ink);font-family:inherit;min-height:96px;display:flex;flex-direction:column;justify-content:space-between}
.pc b{font-size:16px}.pc span{color:var(--pri);font-weight:700;font-size:18px}.pc:active{transform:scale(.97)}
h1,h2{margin:0 0 10px}.mut{color:var(--mut)}small{color:var(--mut);display:block}
.meta{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}
.sec{background:var(--soft);color:var(--ink);border-radius:14px}
.lines{min-height:80px;max-height:340px;overflow:auto}
.ln{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}
.q{display:flex;align-items:center;gap:6px}.q button{width:38px;height:38px;border-radius:50%;border:0;background:var(--soft);color:var(--ink);font-size:20px;cursor:pointer}
.tot{display:flex;justify-content:space-between;background:var(--soft);border-radius:14px;padding:14px;font-size:24px;font-weight:700;margin:12px 0}
.big{width:100%;background:var(--pri);color:#fff;border-radius:14px;margin-bottom:8px;padding:16px}.big:disabled,.sec:disabled{opacity:.45}
.sec{width:100%}.meta .sec{width:auto}.lnk{border:0;background:none;color:var(--mut);width:100%;padding:12px;font:600 15px inherit;font-family:inherit;cursor:pointer}
.row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;padding:14px 0;border-bottom:1px solid var(--line)}
.row .act{display:flex;gap:8px}.row .b{background:var(--soft);color:var(--ink);padding:10px 16px}.row .b.p{background:var(--pri);color:#fff}
.no{color:var(--bad);font-weight:700}.si{color:var(--ok);font-weight:700}
input,select{font:inherit;padding:12px;border-radius:12px;border:0;background:var(--fld);color:var(--ink);width:100%}
label{display:block;font-weight:600;margin:0 0 10px}label input,label select{margin-top:4px;font-weight:400}
.ck{display:flex;gap:10px;align-items:center}.ck input{width:22px;height:22px;margin:0}
.fg{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0 14px}
.ad{display:grid;grid-template-columns:230px 1fr;gap:18px}@media(max-width:820px){.ad{grid-template-columns:1fr}}
.ad .chip{display:block;width:100%;margin-bottom:8px;text-align:left}
.pv{background:#8a97a1;border-radius:14px;padding:16px;display:flex;justify-content:center;overflow:auto}
.tk{background:#fff;color:#000;padding:12px;font-family:Arial,sans-serif}.tk .r{display:flex;justify-content:space-between;gap:8px}.tk hr{border:0;border-top:1px dashed #000;margin:6px 0}.tk .c{text-align:center}
.lg{display:grid;place-items:center;padding:30px 12px}.lg .card{width:min(520px,100%)}
.ucs{display:flex;flex-wrap:wrap;gap:12px}.dots{font-size:30px;letter-spacing:8px;text-align:center;min-height:44px}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:10px 0}.pad button{padding:18px;font-size:22px;border:0;border-radius:14px;background:var(--soft);color:var(--ink);cursor:pointer}
.mesas{display:grid;grid-template-columns:repeat(auto-fill,minmax(70px,1fr));gap:8px;margin:12px 0}.mesas button{padding:16px 0;border:0;border-radius:14px;background:var(--soft);color:var(--ink);font:700 18px inherit;cursor:pointer}.mesas .oc{background:var(--pri);color:#fff}
#mod{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;place-items:center;z-index:50;padding:14px;overflow:auto}#mod .card{width:min(460px,100%);max-height:94vh;overflow:auto}
#kb{position:fixed;left:0;right:0;bottom:0;background:#1d2a36;padding:8px 8px calc(8px + env(safe-area-inset-bottom,0px));display:none;z-index:60}
#kb .kr{display:flex;gap:6px;justify-content:center;margin-bottom:6px}#kb button{flex:1;max-width:70px;padding:14px 0;border:0;border-radius:10px;background:#3a4b5b;color:#fff;font:600 18px inherit;cursor:pointer}#kb .sp{max-width:360px}#kb .wd{max-width:100px}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:90px;background:#0f1b2d;color:#fff;padding:12px 20px;border-radius:999px;display:none;z-index:80}
#print{display:none}@media print{body>*:not(#print){display:none!important}#print{display:block}}
html{-webkit-text-size-adjust:100%}button{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
@media(min-width:821px){.cols aside{position:sticky;top:12px}}
@media(max-width:820px){header{padding:10px 12px;gap:8px}.br{width:100%;font-size:18px}nav{width:100%}nav .b{flex:1;padding:12px 8px;font-size:15px}main{padding:10px}.card{padding:14px;border-radius:16px}.grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr))}.tb{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px}.ad .chip{width:auto;white-space:nowrap;margin:0}.lines{max-height:none}.row .act{width:100%}.row .b{flex:1}}
@media(max-width:480px){.us{width:100%}.fg{grid-template-columns:1fr}#kb button{padding:12px 0;font-size:16px}#kb .kr{gap:4px}}
.tg{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}.th{border:3px solid var(--line);background:var(--card);color:var(--ink);border-radius:16px;padding:10px;text-align:left;cursor:pointer;font:inherit}.th.on{border-color:var(--pri)}.th .sw{display:block;height:44px;border-radius:10px;margin-bottom:8px}
.kg{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px;font-size:18px}.kc{background:var(--card);border-radius:16px;border-top:8px solid #e0a800;padding:14px;display:flex;flex-direction:column;gap:8px}.kc.prep{border-top-color:#1f5fbf}.kc.lista{border-top-color:#17722f}.kh{display:flex;justify-content:space-between;gap:8px}
.kl{display:flex;justify-content:space-between;align-items:center;gap:6px}.kl>button:first-child{flex:1;text-align:left;border:0;background:var(--soft);color:var(--ink);border-radius:10px;padding:12px;font:inherit;cursor:pointer}.kl span{display:flex;gap:4px}.kl span button{width:40px;height:40px;border:0;border-radius:50%;background:var(--soft);color:var(--ink);font-size:20px;cursor:pointer}.kl.dn>button:first-child{text-decoration:line-through;opacity:.5}
.kl em{background:#ffd54a;color:#000;border-radius:6px;padding:0 6px;font-style:normal;margin-left:6px;font-size:.8em}.kn{border:0;background:none;color:var(--ink);text-align:left;padding:8px 0;font:inherit;cursor:pointer;border-top:1px dashed var(--line)}
.chip.pend{outline:2px dashed #e0a800}
</style></head><body>
<div id="app"></div><div id="mod"></div><div id="kb"></div><div id="toast"></div><div id="print"></div>
<!--TPV-BAR-APP-->
<script>var BUILD=7;try{var U0=JSON.parse(localStorage.getItem('tpv_upd')||'null');if(U0&&U0.ver>BUILD&&typeof U0.html=='string'&&U0.html.indexOf('TPV-BAR-APP')>0){document.open();document.write(U0.html);document.close()}}catch(e){}</script>
<script>
{
const $=s=>document.querySelector(s),K='tpvbar1';
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const f=n=>n.toFixed(2).replace('.',',')+' €',num=v=>parseFloat(String(v).replace(',','.'))||0;
const def=()=>({biz:{name:'Bar El Rincón',nif:'',addr:'Calle Mayor, 1',tel:'',iva:10},
tk:{title:'TICKET',prefix:'T-',font:12,width:'80',footer:'Gracias por su visita.',w:true,m:true,q:true},
users:[{id:1,name:'Administrador',role:'admin',pin:'1234'},{id:2,name:'Camarero 1',role:'cam',pin:'0000'}],
cats:['Bebidas','Cafés','Raciones','Bocadillos'],tables:16,orders:{},hist:[],seq:1,uid:3,pid:20,
prods:[['Caña',1.8,'Bebidas'],['Copa de vino',2.5,'Bebidas'],['Refresco',2.2,'Bebidas'],['Agua',1.5,'Bebidas'],['Café solo',1.3,'Cafés'],['Café con leche',1.6,'Cafés'],['Croquetas',8,'Raciones'],['Patatas bravas',6.5,'Raciones'],['Calamares',11,'Raciones'],['Bocadillo de jamón',4.5,'Bocadillos'],['Bocadillo de tortilla',4,'Bocadillos']].map((p,i)=>({id:i+1,n:p[0],p:p[1],c:p[2]}))});
let mem=null,db;try{db=JSON.parse(localStorage.getItem(K))}catch(e){}db=db||mem||def();db.mesas=db.mesas||Array.from({length:db.tables||16},(_,i)=>String(i+1));db.pr=db.pr||{mode:'browser',name:''};db.tk.logoH=db.tk.logoH||50;db.hist.forEach(r=>{r.id=r.id||r.d+'|'+r.no+'|'+r.waiter});db.sync=db.sync||{prov:'',gid:'',mid:'',auto:true,rt:'',last:''};db.kit=db.kit||{role:'',pw:'',host:'',port:8080,code:''};if(db.kit.port==8765)db.kit.port=8080;db.coms=db.coms||[];db.cseq=db.cseq||1;
const save=()=>{mem=db;try{localStorage.setItem(K,JSON.stringify(db))}catch(e){}};
const S={user:null,view:'caja',cat:null,cur:null,filter:'all',set:'biz',sel:null,pin:'',err:'',kb:false,sh:false,ae:null,after:null,pend:null};
const toast=t=>{const e=$('#toast');e.textContent=t;e.style.display='block';setTimeout(()=>e.style.display='none',2200)};
const modal=h=>{const m=$('#mod');m.innerHTML='<div class="card">'+h+'</div>';m.style.display='grid'};
const closeM=()=>{$('#mod').style.display='none'};
const tot=o=>o.items.reduce((s,i)=>s+i.p*i.q,0);
const get=(o,k)=>k.split('.').reduce((a,x)=>a[x],o);
function setp(o,k,v){const p=k.split('.'),l=p.pop();get(o,p.length?p.join('.'):'')&&0;let t=o;p.forEach(x=>t=t[x]);t[l]=v}

function tkHTML(r){const t=db.tk,b=db.biz;
const d=new Date(r.d).toLocaleString('es-ES');
return `<div class="tk" style="width:${t.width=='58'?'220':'300'}px;font-size:${t.font}px">
<div class="c">${b.logo?`<img src="${b.logo}" style="height:${t.logoH}px;max-width:100%;object-fit:contain"><br>`:''}<b style="font-size:1.2em">${esc(b.name)}</b>${b.nif?'<div>NIF '+esc(b.nif)+'</div>':''}<div>${esc(b.addr)}</div>${b.tel?'<div>Tel. '+esc(b.tel)+'</div>':''}</div><hr>
<div class="c"><b>${esc(t.title)}</b><div>Nº ${esc(t.prefix)}${fmtNo(r.no)}</div><div>${d}</div>${t.m?`<div>Mesa ${esc(r.mesa)}${r.mname?' · '+esc(r.mname):''}</div>`:''}${t.w?'<div>Atiende: '+esc(r.waiter)+'</div>':''}${r.cust?'<div>Cliente: '+esc(r.cust)+'</div>':''}</div><hr>
${r.items.map(i=>`<div class="r"><span>${t.q?i.q+' x ':''}${esc(i.n)}</span><b>${f(i.p*i.q)}</b></div>`).join('')}<hr>
<div class="r" style="font-size:1.3em"><b>TOTAL</b><b>${f(r.total)}</b></div>

<div>${r.paid?'Pago: '+esc(r.method)+' · PAGADA':'PENDIENTE DE PAGO'}</div><hr><div class="c">${esc(t.footer)}</div></div>`}
const sample=()=>({d:new Date(),no:'0001',mesa:5,mname:'Terraza',cust:'Ana García López',waiter:S.user?S.user.name:'Camarero',total:9.7,paid:true,method:'Tarjeta',items:[{n:'Caña',p:1.8,q:2},{n:'Croquetas',p:8,q:1}].map(x=>x)});
const fmtNo=n=>String(n).padStart(4,'0');

function render(){const u=S.user,a=$('#app');
if(S.kit){a.innerHTML=kitchen();return}
if(!u){a.innerHTML=login();return}
if(!S.cat||!db.cats.includes(S.cat))S.cat=db.cats[0];
const nb=(v,t)=>`<button class="b ${S.view==v?'w on':''}" data-a="view" data-v="${v}">${t}</button>`;
a.innerHTML=`<header><b class="br">${esc(db.biz.name)}</b><span class="us">Usuario: <b>${esc(u.name)}</b></span><nav>${nb('caja','Caja')}${nb('hist','Historial')}${u.role=='admin'?nb('aj','Ajustes'):''}<button class="b ${S.kb?'w on':''}" data-a="kbt">Teclado táctil</button><button class="b" data-a="out">Salir</button></nav></header><main>${S.view=='caja'?caja():S.view=='hist'?hist():ajustes()}</main>`}

function login(){if(S.sel){const x=db.users.find(u=>u.id==S.sel);
return `<div class="lg"><div class="card"><h1>${esc(x.name)}</h1><p class="mut">Introduce tu PIN</p><div class="dots">${'●'.repeat(S.pin.length)||'&nbsp;'}</div><div class="no" style="text-align:center">${S.err}</div><div class="pad">${[1,2,3,4,5,6,7,8,9,'⌫',0,'Entrar'].map(k=>`<button data-a="pk" data-v="${k}">${k}</button>`).join('')}</div><button class="lnk" data-a="back">Volver</button></div></div>`}
return `<div class="lg"><div class="card"><h1>${esc(db.biz.name)}</h1><p class="mut">Toque su nombre para entrar</p><div class="ucs">${db.users.map(u=>`<button class="pc" data-a="login" data-v="${u.id}"><b>${esc(u.name)}</b><small>${u.role=='admin'?'Administrador':'Camarero'}</small></button>`).join('')}</div><div style="margin-top:14px"><button class="b sec" style="width:auto" data-a="kmodal">Cocina</button> ${db.kit.role=='kitchen'?'<button class="b big" style="width:auto;margin:0" data-a="kback">Pantalla de cocina</button>':''}</div></div></div>`}

function caja(){const o=db.orders[S.cur],ps=db.prods.filter(p=>p.c==S.cat),t=o?tot(o):0,dis=o&&o.items.length?'':'disabled';
return `<div class="cols"><section><div class="chips">${db.cats.map(c=>`<button class="chip ${c==S.cat?'on':''}" data-a="cat" data-v="${esc(c)}">${esc(c)}</button>`).join('')}</div>
<div class="grid">${ps.map(p=>`<button class="pc" data-a="prod" data-v="${p.id}"><b>${esc(p.n)}</b><span>${f(p.p)}</span></button>`).join('')||'<p class="mut">No hay productos en esta categoría. El administrador puede añadirlos en Ajustes.</p>'}</div></section>
<aside class="card"><h2>Cuenta</h2>
${(()=>{const l=Object.values(db.orders).filter(x=>x.items.length||x.num==S.cur);return l.length?`<small>Cuentas abiertas</small><div class="chips">${l.map(x=>`<button class="chip ${x.num==S.cur?'on':''}${x.pend?' pend':''}" style="padding:8px 14px" data-a="sw" data-v="${esc(x.num)}">Mesa ${esc(x.num)} · ${f(tot(x))}${x.pend?' ⏸':''}</button>`).join('')}</div>`:''})()}
<div class="meta"><div><small>Camarero</small><b>${esc(o?o.waiter:S.user.name)}</b></div><button class="b sec" data-a="mesa">${o?'Mesa '+o.num+(o.name?' · '+esc(o.name):''):'Elegir mesa'}</button></div>
<div class="lines">${o&&o.items.length?o.items.map((i,k)=>`<div class="ln"><span>${esc(i.n)}</span><span class="q"><button data-a="mn" data-v="${k}">−</button><b>${i.q}</b><button data-a="pl" data-v="${k}">+</button></span><b>${f(i.p*i.q)}</b></div>`).join(''):'<p class="mut">Pulse un producto para añadirlo.</p>'}</div>
<div class="tot"><span>Total</span><b>${f(t)}</b></div>
${kbtn(o,dis)}<button class="b big" data-a="cobrar" ${dis}>Cobrar (pagada)</button><button class="b sec" style="margin-bottom:8px" data-a="pend" ${dis}>Dejar pendiente (piden más)</button><button class="b sec" data-a="later" ${dis}>Cerrar como no pagada</button><button class="lnk" data-a="clear" ${dis}>Vaciar cuenta</button></aside></div>`}

function hist(){const adm=S.user.role=='admin';
let l=db.hist.filter(r=>adm||r.waiter==S.user.name).filter(r=>S.filter=='all'||(S.filter=='p'?r.paid:!r.paid));
const ch=(v,t)=>`<button class="chip ${S.filter==v?'on':''}" data-a="fl" data-v="${v}">${t}</button>`;
return `<div class="card"><h1>Historial de cuentas</h1><div class="chips">${ch('all','Todos')}${ch('p','Pagados')}${ch('n','No pagados')}</div>
${l.map(r=>`<div class="row"><div><b>${esc(fmtNo(r.no))}</b> · ${new Date(r.d).toLocaleString('es-ES')}<div class="mut">Mesa ${esc(r.mesa)}${r.mname?' · '+esc(r.mname):''} · Atendió ${esc(r.waiter)}${r.cust?' · Cliente '+esc(r.cust):''} · ${f(r.total)}</div><div class="${r.paid?'si':'no'}">${r.paid?'Pagado ('+esc(r.method)+')':'No pagado'}</div></div><div class="act">${r.paid?'':`<button class="b p" data-a="cobh" data-v="${r.id}">Cobrar</button>`}<button class="b" data-a="tick" data-v="${r.id}">Ver / imprimir</button></div></div>`).join('')||'<p class="mut">Aún no hay cuentas en esta lista.</p>'}</div>`}

const fld=(l,k,x='')=>`<label>${l}<input data-k="${k}" ${x} value="${esc(get(db,k))}"></label>`;
const ckb=(l,k)=>`<label class="ck"><input type="checkbox" data-k="${k}" ${get(db,k)?'checked':''}> ${l}</label>`;
function ajustes(){const tabs=[['biz','Negocio'],['mesas','Mesas'],['cats','Categorías'],['prods','Productos'],['tk','Diseño del ticket'],['pr','Impresión'],['bk','Copias y traslados'],['sy','Sincronización'],['ap','Apariencia'],['up','Actualización'],['users','Usuarios y claves']];
let c='';
if(S.set=='biz')c=`<h1>Datos del negocio</h1><div class="fg">${fld('Nombre','biz.name')}${fld('NIF','biz.nif')}${fld('Dirección','biz.addr')}${fld('Teléfono','biz.tel')}</div><h2>Logo</h2>${db.biz.logo?`<img src="${db.biz.logo}" style="max-height:80px;display:block;margin-bottom:10px;background:#fff;padding:4px;border-radius:8px">`:'<p class="mut">Aún no hay logo.</p>'}<label>Subir logo<input type="file" accept="image/*" id="lg"></label>${db.biz.logo?'<button class="b sec" style="width:auto" data-a="lgdel">Quitar logo</button>':''}`;
if(S.set=='tk')c=`<h1>Diseño del ticket</h1><div class="fg">${fld('Título del ticket','tk.title')}${fld('Prefijo del número','tk.prefix')}${fld('Tamaño de letra (px)','tk.font','data-n=1 inputmode=numeric')}${fld('Altura del logo (px)','tk.logoH','data-n=1 inputmode=numeric')}<label>Ancho del papel<select data-k="tk.width"><option value="58" ${db.tk.width=='58'?'selected':''}>58 mm</option><option value="80" ${db.tk.width=='80'?'selected':''}>80 mm</option></select></label>${fld('Pie del ticket','tk.footer')}</div>${ckb('Mostrar camarero','tk.w')}<br>${ckb('Mostrar nombre y número de mesa','tk.m')}<br>${ckb('Mostrar cantidad en cada línea','tk.q')}<h2 style="margin-top:18px">Vista previa</h2><div class="pv" id="pv">${tkHTML(sample())}</div>`;
if(S.set=='mesas')c=`<h1>Mesas</h1><div class="mesas">${db.mesas.map(m=>`<button class="${db.orders[m]?'oc':''}" data-a="mdel" data-v="${esc(m)}">${esc(m)} ✕</button>`).join('')||'<p class="mut">No hay mesas.</p>'}</div><p class="mut">Toca una mesa para eliminarla. Las mesas con cuenta abierta no se pueden eliminar.</p><div class="fg"><label>Nueva mesa (número o nombre)<input id="mt" value="${esc(nextMesa())}"></label></div><button class="b big" style="width:auto" data-a="madd">Añadir mesa</button>`;
if(S.set=='cats')c=`<h1>Categorías</h1>${db.cats.map(x=>`<div class="row"><b>${esc(x)}</b><button class="b" style="color:var(--bad)" data-a="cdel" data-v="${esc(x)}">Eliminar</button></div>`).join('')}<h2 style="margin-top:16px">Nueva categoría</h2><div class="fg"><label><input id="cn" placeholder="Nombre"></label></div><button class="b big" style="width:auto" data-a="cadd">Añadir categoría</button>`;
if(S.set=='pr')c=`<h1>Impresión de tickets</h1><label>Imprimir con<select data-k="pr.mode"><option value="browser" ${db.pr.mode!='bt'?'selected':''}>Impresora del dispositivo</option><option value="bt" ${db.pr.mode=='bt'?'selected':''}>Impresora Bluetooth</option></select></label><p class="mut">${BT.dev&&BT.dev.gatt.connected?'Conectada: '+esc(BT.dev.name||'impresora'):'Sin conectar'}${db.pr.name?' · última: '+esc(db.pr.name):''}</p><button class="b big" style="width:auto" data-a="btc">Conectar impresora Bluetooth</button> <button class="b sec" style="width:auto" data-a="btt">Imprimir prueba</button><p class="mut">El Bluetooth funciona con impresoras térmicas BLE desde Chrome o Edge (no en iPhone ni iPad). El logo solo se imprime con la impresora del dispositivo.</p>`;
if(S.set=='bk')c=`<h1>Copias y traslados</h1><h2>Copia de seguridad en la nube (solo tickets)</h2><p class="mut">Genera un archivo con todos los tickets, sin usuarios ni claves. En Android el menú de compartir te deja guardarlo en Google Drive, OneDrive o enviarlo por correo.</p><button class="b big" style="width:auto" data-a="bkx">Guardar copia de los tickets</button><p class="mut">${db.lastBk?'Última copia: '+new Date(db.lastBk).toLocaleString('es-ES'):'Aún no has guardado ninguna copia.'}</p><label>Restaurar tickets desde una copia<input type="file" accept=".json,application/json" id="bki"></label>
<h2 style="margin-top:20px">Trasladar un usuario a otro dispositivo</h2><label>Usuario<select id="tu">${db.users.map(u=>`<option value="${u.id}">${esc(u.name)}</option>`).join('')}</select></label><label class="ck"><input type="checkbox" id="tm"> Quitarlo de este dispositivo tras exportar</label><br><button class="b big" style="width:auto" data-a="tux">Exportar usuario y sus tickets</button><label style="margin-top:14px">Importar un usuario desde otro dispositivo<input type="file" accept=".json,application/json" id="tui"></label>`;
if(S.set=='sy')c=`<h1>Sincronización automática</h1><p class="mut">Los tickets se guardan solos en tu Google Drive o en tu OneDrive, en una carpeta propia de la app, y los dispositivos con la misma cuenta se unen en uno solo. Solo se sincronizan los tickets.</p><label>Servicio<select data-k="sync.prov"><option value="" ${!db.sync.prov?'selected':''}>Desactivada</option><option value="google" ${db.sync.prov=='google'?'selected':''}>Google Drive</option><option value="ms" ${db.sync.prov=='ms'?'selected':''}>OneDrive</option></select></label><div class="fg">${fld('ID de cliente de Google','sync.gid')}${fld('ID de cliente de Microsoft','sync.mid')}</div>${ckb('Sincronizar automáticamente (al cobrar y cada 5 minutos)','sync.auto')}<br><button class="b big" style="width:auto" data-a="syc">Conectar cuenta</button> <button class="b sec" style="width:auto" data-a="syn">Sincronizar ahora</button><p class="mut" id="sst">${syncText()}</p><p class="mut">Dirección de redirección para Microsoft: <b>${esc(redirect())}</b></p><p class="mut">Solo funciona en la versión instalada desde tu propio https, no en la vista previa de Claude. Los pasos para crear los ID de cliente están en LEEME.txt del paquete.</p>`;
if(S.set=='ap')c=`<h1>Apariencia</h1><p class="mut">Elige el tema de la aplicación.</p><div class="tg">${Object.entries(THEMES).map(([k,t])=>`<button class="th ${(db.theme||'auto')==k?'on':''}" data-a="theme" data-v="${k}"><span class="sw" style="background:${t.sw}"></span><b>${t.n}</b></button>`).join('')}</div>`;
if(S.set=='up'){const g=updSaved();c=`<h1>Actualización</h1><p>Versión instalada: <b>${BUILD}</b>${g&&g.ver==BUILD?' (descargada de GitHub)':''}</p><p class="mut">La app busca las novedades en el repositorio oficial. Los datos (ventas, tickets, usuarios, productos y ajustes) se conservan.</p><button class="b big" style="width:auto" data-a="updchk">Buscar actualizaciones</button> ${g?'<button class="b sec" style="width:auto" data-a="updrop">Volver a la versión original</button>':''}<p class="mut" id="ust">${esc(UPST)}</p><p class="mut">Repositorio: ${esc(REPO)}</p>`}
if(S.set=='users')c=`<h1>Usuarios y claves</h1>${db.users.map(u=>`<div class="row" style="gap:6px"><div style="flex:2;min-width:140px"><input data-l="users" data-id="${u.id}" data-f="name" value="${esc(u.name)}"></div><div style="flex:1;min-width:120px"><select data-l="users" data-id="${u.id}" data-f="role"><option value="cam" ${u.role=='cam'?'selected':''}>Camarero</option><option value="admin" ${u.role=='admin'?'selected':''}>Administrador</option></select></div><div style="flex:1;min-width:90px"><input data-l="users" data-id="${u.id}" data-f="pin" value="${esc(u.pin)}" inputmode="numeric" maxlength="4" placeholder="PIN"></div>${u.role=='cam'?`<label class="ck" style="margin:0"><input type="checkbox" data-l="users" data-id="${u.id}" data-f="np" ${u.np?'checked':''}> Sin PIN</label>`:''}<button class="b" style="background:var(--soft);color:var(--bad)" data-a="udel" data-v="${u.id}">Eliminar</button></div>`).join('')}<h2 style="margin-top:16px">Nuevo usuario</h2><div class="fg"><label>Nombre<input id="un"></label><label>Rol<select id="ur"><option value="cam">Camarero</option><option value="admin">Administrador</option></select></label><label>PIN (4 cifras)<input id="up" maxlength="4" inputmode="numeric"></label><label class="ck" style="align-self:end"><input type="checkbox" id="un2"> Camarero sin PIN</label></div><button class="b big" style="width:auto" data-a="uadd">Añadir usuario</button>`;
if(S.set=='prods')c=`<h1>Productos</h1>${db.prods.map(p=>`<div class="row" style="gap:6px"><div style="flex:2;min-width:140px"><input data-l="prods" data-id="${p.id}" data-f="n" value="${esc(p.n)}"></div><div style="flex:1;min-width:80px"><input data-l="prods" data-id="${p.id}" data-f="p" data-n="1" inputmode="decimal" value="${String(p.p).replace('.',',')}"></div><div style="flex:1;min-width:120px"><select data-l="prods" data-id="${p.id}" data-f="c">${db.cats.map(x=>`<option ${x==p.c?'selected':''}>${esc(x)}</option>`).join('')}</select></div><button class="b" style="background:var(--soft);color:var(--bad)" data-a="pdel" data-v="${p.id}">Eliminar</button></div>`).join('')}<h2 style="margin-top:16px">Nuevo producto</h2><div class="fg"><label>Nombre<input id="pn"></label><label>Precio (€)<input id="pp" inputmode="decimal"></label><label>Categoría<select id="pc">${db.cats.map(x=>`<option>${esc(x)}</option>`).join('')}</select></label></div><button class="b big" style="width:auto" data-a="padd">Añadir producto</button>`;
return `<div class="ad"><div class="tb">${tabs.map(t=>`<button class="chip ${S.set==t[0]?'on':''}" data-a="set" data-v="${t[0]}">${t[1]}</button>`).join('')}</div><div class="card">${c}</div></div>`}

function openOrder(n,name){let o=db.orders[n];if(!o)o=db.orders[n]={num:n,name:'',waiter:S.user.name,items:[]};if(name)o.name=name;o.pend=false;S.cur=n;save()}
function addItem(id){const p=db.prods.find(x=>x.id==id),o=db.orders[S.cur],i=o.items.find(x=>x.id==id);i?i.q++:o.items.push({id:p.id,n:p.n,p:p.p,q:1});save()}
function finish(paid,method,cust){const o=db.orders[S.cur],r={no:db.seq++,d:new Date().toISOString(),waiter:o.waiter,mesa:o.num,mname:o.name,items:o.items,total:tot(o),paid,method:method||'',cust:cust||''};
r.id=r.d+'|'+r.no+'|'+r.waiter;db.hist.unshift(r);setTimeout(()=>doSync(true),300);delete db.orders[S.cur];S.cur=null;save();render();closeM();toast(paid?'Cuenta cobrada':'Cuenta guardada sin pagar');if(paid)showTick(r.id)}
function showTick(no){const r=db.hist.find(x=>x.id==no);modal(`<div class="pv">${tkHTML(r)}</div><div class="meta" style="margin-top:12px"><button class="b sec" data-a="closeM">Cerrar</button><button class="b big" style="margin:0" data-a="print" data-v="${no}">Imprimir</button></div>`)}
function payM(h){modal(`<h2>Cobrar ${h}</h2><button class="b big" data-a="${S.pend?'payh':'pay'}" data-v="Efectivo">Efectivo</button><button class="b big" data-a="${S.pend?'payh':'pay'}" data-v="Tarjeta">Tarjeta</button><button class="lnk" data-a="closeM">Cancelar</button>`)}

function cust(){const c=($('#cu').value||'').trim();if(c.split(/\s+/).length<2){toast('Escribe nombre y apellidos del cliente');return''}return c}
function custM(pay){const t=f(tot(db.orders[S.cur]));modal(`<h2>${pay?'Cobrar':'Dejar sin pagar'} ${t}</h2><label>Nombre y apellidos del cliente<input id="cu" autocomplete="off"></label>${pay?'<button class="b big" data-a="pay" data-v="Efectivo">Efectivo</button><button class="b big" data-a="pay" data-v="Tarjeta">Tarjeta</button>':'<button class="b big" data-a="lat">Guardar sin pagar</button>'}<button class="lnk" data-a="closeM">Cancelar</button>`);setTimeout(()=>$('#cu').focus(),60)}
let BT={dev:null,ch:null};
const CP={'á':0xA0,'é':0x82,'í':0xA1,'ó':0xA2,'ú':0xA3,'ñ':0xA4,'Ñ':0xA5,'¿':0xA8,'¡':0xAD,'ü':0x81,'Á':0xB5,'É':0x90,'Í':0xD6,'Ó':0xE0,'Ú':0xE9,'€':0xD5,'·':0xFA,'º':0xA7};
const enc=s=>[...s].map(c=>CP[c]??(c.charCodeAt(0)<128?c.charCodeAt(0):63));
function escpos(r){const t=db.tk,b=db.biz,W=t.width=='58'?32:48,o=[0x1B,0x40,0x1B,0x74,19];
const P=s=>o.push(...enc(s)),C=x=>o.push(0x1B,0x61,x),B=x=>o.push(0x1B,0x45,x),H='-'.repeat(W)+'\n';
const L=(a,c)=>{a=String(a);c=String(c);P(a.slice(0,W-c.length-1).padEnd(W-c.length)+c+'\n')};
C(1);B(1);P(b.name+'\n');B(0);if(b.nif)P('NIF '+b.nif+'\n');P(b.addr+'\n');if(b.tel)P('Tel. '+b.tel+'\n');P(H);
B(1);P(t.title+'\n');B(0);P('Nº '+t.prefix+fmtNo(r.no)+'\n'+new Date(r.d).toLocaleString('es-ES')+'\n');
if(t.m)P('Mesa '+r.mesa+(r.mname?' · '+r.mname:'')+'\n');if(t.w)P('Atiende: '+r.waiter+'\n');if(r.cust)P('Cliente: '+r.cust+'\n');
C(0);P(H);r.items.forEach(i=>L((t.q?i.q+' x ':'')+i.n,f(i.p*i.q)));P(H);B(1);L('TOTAL',f(r.total));B(0);
P((r.paid?'Pago: '+r.method+' · PAGADA':'PENDIENTE DE PAGO')+'\n');C(1);P(H+t.footer+'\n\n\n\n');o.push(0x1D,0x56,0);return new Uint8Array(o)}
async function btConnect(){if(!navigator.bluetooth)throw Error('Este navegador no permite Bluetooth. Usa Chrome o Edge.');
const d=await navigator.bluetooth.requestDevice({acceptAllDevices:true,optionalServices:['000018f0-0000-1000-8000-00805f9b34fb','e7810a71-73ae-499d-8c15-faa9aef0c3f2','49535343-fe7d-4ae5-8fa9-9fafd205e455','0000ff00-0000-1000-8000-00805f9b34fb']});
const g=await d.gatt.connect();for(const v of await g.getPrimaryServices())for(const c of await v.getCharacteristics())if(c.properties.write||c.properties.writeWithoutResponse){BT={dev:d,ch:c};db.pr.name=d.name||'';save();return}
throw Error('No encuentro canal de escritura en esa impresora')}
async function btSend(b){const c=BT.ch;for(let i=0;i<b.length;i+=100){const x=b.slice(i,i+100);c.properties.writeWithoutResponse?await c.writeValueWithoutResponse(x):await c.writeValue(x);await new Promise(r=>setTimeout(r,25))}}
const nextMesa=()=>String(Math.max(0,...db.mesas.map(Number).filter(n=>!isNaN(n)))+1);
const VARS=['--bg','--card','--ink','--mut','--pri','--soft','--bad','--ok','--fld','--line','--h1','--h2'];
const T=(n,d,bg,card,ink,mut,pri,soft,fld,line,h1,h2,bad='#b3261e',ok='#17722f')=>({n,d,sw:`linear-gradient(90deg,${h1},${h2})`,v:Object.fromEntries(VARS.map((k,i)=>[k,[bg,card,ink,mut,pri,soft,bad,ok,fld,line,h1,h2][i]]))});
const THEMES={auto:{n:'Automático',sw:'linear-gradient(90deg,#13766c 50%,#0f1720 50%)'},
turquesa:T('Turquesa',0,'#eef1f5','#fff','#0f1b2d','#5b6677','#13766c','#e3eeee','#eeeff1','#e2e6ea','#0d3b44','#13766c'),
cerveza:T('Cerveza',0,'#f6f1e7','#fff','#2a1b08','#6d5a3f','#b86e00','#f4e6cc','#f0e8d8','#e6dcc6','#4a2c0a','#b86e00'),
vino:T('Vino',0,'#f5eef0','#fff','#2a0d16','#6b4a54','#8c1c3a','#f0dde3','#eee3e6','#e4d3d8','#3b0d1b','#8c1c3a'),
azul:T('Azul marino',0,'#eef2f9','#fff','#0f1b2d','#546177','#1f5fbf','#dde8f7','#e8edf5','#d9e1ee','#0b2a5b','#1f5fbf'),
bosque:T('Bosque',0,'#eef4ee','#fff','#11210f','#4f6350','#2e7d32','#dcebdc','#e6eee6','#d5e2d5','#12361a','#2e7d32'),
oscuro:T('Oscuro',1,'#0f1720','#18232f','#eaf0f6','#9aa8b8','#2aa396','#1f3a3d','#223040','#2a3846','#0d3b44','#13766c','#ff8a80','#6fdc8c'),
medianoche:T('Medianoche',1,'#0b1020','#141b2f','#e8ecff','#98a3c7','#5b8def','#1c2745','#1b2440','#27325a','#0b1020','#1d3a8a','#ff8a80','#6fdc8c'),
contraste:T('Alto contraste',0,'#ffffff','#fff','#000','#222','#0000c8','#e6e6e6','#ececec','#000','#000','#222','#b00020','#006400')};
function applyTheme(){const r=document.documentElement,t=THEMES[db.theme||'auto']||THEMES.auto;VARS.forEach(x=>r.style.removeProperty(x));
if(t.v){VARS.forEach(x=>r.style.setProperty(x,t.v[x]));r.style.colorScheme=t.d?'dark':'light'}else r.style.colorScheme=''}
// Sincronización automática
const SY={tok:null,exp:0,busy:false,msg:''},FN='tpvbar-tickets.json',redirect=()=>location.origin+location.pathname;
const syncText=()=>(db.sync.prov?'Servicio: '+(db.sync.prov=='google'?'Google Drive':'OneDrive'):'Sincronización desactivada')+(db.sync.last?' · última vez '+new Date(db.sync.last).toLocaleString('es-ES'):'')+(SY.msg?' · '+SY.msg:'');
function merge(a){const m=new Map(db.hist.map(r=>[r.id,r]));(a||[]).forEach(r=>{if(!r||typeof r.d!='string'||!Array.isArray(r.items))return;r.id=r.id||r.d+'|'+r.no+'|'+r.waiter;const x=m.get(r.id);if(!x)m.set(r.id,r);else if(r.paid&&!x.paid)Object.assign(x,r)});db.hist=[...m.values()].sort((p,q)=>q.d.localeCompare(p.d))}
const gLoad=()=>new Promise((ok,ko)=>{if(window.google&&google.accounts)return ok();const e=document.createElement('script');e.src='https://accounts.google.com/gsi/client';e.onload=ok;e.onerror=()=>ko(Error('No se pudo cargar Google. Comprueba la conexión.'));document.head.appendChild(e)});
async function gToken(){if(SY.tok&&Date.now()<SY.exp)return SY.tok;await gLoad();return new Promise((ok,ko)=>{google.accounts.oauth2.initTokenClient({client_id:db.sync.gid,scope:'https://www.googleapis.com/auth/drive.appdata',callback:r=>{if(r.error)return ko(Error('Google: '+r.error));SY.tok=r.access_token;SY.exp=Date.now()+(r.expires_in-120)*1000;ok(r.access_token)},error_callback:()=>ko(Error('Hace falta reconectar: pulsa Sincronizar ahora'))}).requestAccessToken()})}
const chk=r=>{if(!r.ok)throw Error('Error '+r.status+' del servicio de nube');return r};
async function gSync(t){const H={Authorization:'Bearer '+t},l=await(await chk(await fetch('https://www.googleapis.com/drive/v3/files?spaces=appDataFolder&fields=files(id)&q='+encodeURIComponent("name='"+FN+"'"),{headers:H}))).json();
const id=l.files&&l.files[0]&&l.files[0].id;if(id)merge((await(await chk(await fetch('https://www.googleapis.com/drive/v3/files/'+id+'?alt=media',{headers:H}))).json()).hist);
save();const body=JSON.stringify({t:'tickets',hist:db.hist});
if(id)chk(await fetch('https://www.googleapis.com/upload/drive/v3/files/'+id+'?uploadType=media',{method:'PATCH',headers:{...H,'Content-Type':'application/json'},body}));
else{const f=new FormData();f.append('metadata',new Blob([JSON.stringify({name:FN,parents:['appDataFolder']})],{type:'application/json'}));f.append('file',new Blob([body],{type:'application/json'}));chk(await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart',{method:'POST',headers:H,body:f}))}}
const b64=b=>btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
const MS='https://login.microsoftonline.com/common/oauth2/v2.0/',SC='Files.ReadWrite.AppFolder offline_access';
async function msStart(){const v=b64(crypto.getRandomValues(new Uint8Array(32))),c=b64(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(v)));try{localStorage.setItem('tpv_ms_v',v)}catch(e){}
location.href=MS+'authorize?'+new URLSearchParams({client_id:db.sync.mid,response_type:'code',redirect_uri:redirect(),response_mode:'query',scope:SC,code_challenge:c,code_challenge_method:'S256',state:'tpvms'})}
async function msTok(b){const j=await(await fetch(MS+'token',{method:'POST',body:new URLSearchParams({client_id:db.sync.mid,redirect_uri:redirect(),scope:SC,...b})})).json();if(j.error)throw Error('Microsoft: '+String(j.error_description||j.error).split('\n')[0]);SY.tok=j.access_token;SY.exp=Date.now()+(j.expires_in-120)*1000;if(j.refresh_token){db.sync.rt=j.refresh_token;save()}return j.access_token}
async function msToken(){if(SY.tok&&Date.now()<SY.exp)return SY.tok;if(!db.sync.rt)throw Error('Conecta tu cuenta de Microsoft');return msTok({grant_type:'refresh_token',refresh_token:db.sync.rt})}
async function msSync(t){const H={Authorization:'Bearer '+t},U='https://graph.microsoft.com/v1.0/me/drive/special/approot:/'+FN+':/content',r=await fetch(U,{headers:H});
if(r.ok)merge((await r.json()).hist);else if(r.status!=404)chk(r);save();chk(await fetch(U,{method:'PUT',headers:{...H,'Content-Type':'application/json'},body:JSON.stringify({t:'tickets',hist:db.hist})}))}
async function doSync(quiet){const y=db.sync,p=y.prov;if(!p||SY.busy||(p=='google'&&!y.gid)||(p=='ms'&&!y.mid))return;if(quiet&&!y.auto)return;SY.busy=true;
try{const t=p=='google'?await gToken():await msToken();await(p=='google'?gSync(t):msSync(t));y.last=new Date().toISOString();SY.msg='';save();if(!quiet)toast('Sincronizado')}catch(e){SY.msg=e.message||'No se pudo sincronizar';if(!quiet)toast(SY.msg)}
SY.busy=false;if(S.user&&S.view=='hist')render();const e=$('#sst');if(e)e.textContent=syncText()}
async function syncInit(){const u=new URLSearchParams(location.search);if(u.get('state')=='tpvms'&&u.get('code')){history.replaceState({},'',redirect());try{await msTok({grant_type:'authorization_code',code:u.get('code'),code_verifier:localStorage.getItem('tpv_ms_v')});db.sync.prov='ms';save();toast('OneDrive conectado')}catch(e){toast(e.message)}}
setInterval(()=>doSync(true),300000);doSync(true)}
async function shareFile(name,obj){const blob=new Blob([JSON.stringify(obj)],{type:'application/json'}),file=new File([blob],name,{type:'application/json'});
try{if(navigator.canShare&&navigator.canShare({files:[file]})){await navigator.share({files:[file],title:name});return true}}catch(e){if(e.name=='AbortError')return false}
const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),4000);return true}
const updSaved=()=>{try{return JSON.parse(localStorage.getItem('tpv_upd')||'null')}catch(e){return null}};
const REPO='reparacioneshontecillas-creator/tpv-actualizaciones',RAW='https://raw.githubusercontent.com/'+REPO+'/main/';
let UP=null,UPST='';
const upst=t=>{UPST=t;const e=$('#ust');if(e)e.textContent=t};
async function updCheck(quiet){try{if(!quiet)upst('Buscando…');const r=await fetch(RAW+'actualizacion.tpvup?t='+Date.now(),{cache:'no-store'});
if(r.status==404)throw Error('No hay ningún archivo actualizacion.tpvup en el repositorio');if(!r.ok)throw Error('Error '+r.status+' al leer el repositorio');
const tx=await r.text(),m=tx.match(/var BUILD=(\d+);/);
if(!m||tx.indexOf('TPV-BAR-APP')<0||tx.indexOf('id="app"')<0)throw Error('El archivo del repositorio no es una actualización válida de TPV Bar');
const v=+m[1];if(v<=BUILD){upst('Tienes la última versión ('+BUILD+').');if(!quiet)toast('Ya estás al día');return}
const n=tx.match(/<!--TPV-NOTAS:([\s\S]*?)-->/);UP={ver:v,html:tx,notes:n?n[1].trim():''};upst('Hay una versión nueva: '+v);
if(quiet){toast('Hay una actualización. Ve a Ajustes > Actualización');return}
modal(`<h2>Actualización disponible: versión ${v}</h2><p class="mut">Ahora tienes la ${BUILD}.</p>${UP.notes?`<p>${esc(UP.notes)}</p>`:''}<p class="mut">Tus datos no se tocan y la app se reiniciará.</p><button class="b big" data-a="upgo">Actualizar ahora</button><button class="lnk" data-a="closeM">Más tarde</button>`)}
catch(e){const m=e.message=='Failed to fetch'?'Sin conexión con GitHub. Comprueba internet.':e.message;if(!quiet){upst(m);toast(m)}}}
// Comandas de cocina (sin internet: red local)
const KS={coms:[],ok:false,msg:'',bc:null,cid:'c'+Math.random().toString(36).slice(2),auth:new Set(),tm:null,noretry:false,link:''};
const stN={nueva:'Pendiente',prep:'En preparación',lista:'Lista para servir'};
const hm=t=>new Date(t).toLocaleTimeString('es-ES',{hour:'2-digit',minute:'2-digit'});
const beep=()=>{try{const a=new (window.AudioContext||window.webkitAudioContext)(),o=a.createOscillator();o.connect(a.destination);o.frequency.value=880;o.start();setTimeout(()=>{o.stop();a.close()},300)}catch(e){}};
const kUi=()=>{if(S.kit||(S.user&&S.view=='caja'))render()};
const admOk=x=>db.users.some(u=>u.role=='admin'&&u.pin&&u.pin===String(x).trim());
function kStart(){KS.auth.clear();
if(window.TPVNative&&!TPVNative.clientSend){KS.ok=false;KS.msg='Falta actualizar el APK con el módulo de cocina nuevo'}
else if(window.TPVNative){KS.ok=!!TPVNative.startServer(db.kit.port||8080,db.kit.code||'',db.kit.pw||'');KS.msg=KS.ok?'Cocina activa · Código: '+db.kit.code+' · IP: '+TPVNative.getIp()+':'+(db.kit.port||8080):'No se pudo abrir el puerto '+(db.kit.port||8080)+' de la cocina'}
else{KS.bc=KS.bc||new BroadcastChannel('tpv-kitchen');KS.bc.onmessage=e=>{if(e.data&&e.data.from)kRecv(e.data.from,e.data.m)};KS.ok=true;KS.msg=navigator.userAgent.includes('; wv)')?'Este APK no incluye el módulo de cocina (TPVNative). Instala el APK nuevo con KitchenBridge.kt.':'Modo de prueba (solo entre pestañas de este navegador). Código: prueba'}
try{navigator.wakeLock&&navigator.wakeLock.request('screen')}catch(e){}}
window.tpvOnClient=(id,t)=>{let m;try{m=JSON.parse(t)}catch(e){return}kRecv(id,m)};window.tpvOnClose=id=>KS.auth.delete(id);window.tpvOnOpen=id=>{if(db.kit.role!='kitchen')return;KS.auth.add(id);kOut(id,{t:'ok',coms:db.coms.filter(c=>c.st!='servida')})};window.tpvOnServer=t=>{try{cRecv(JSON.parse(t))}catch(e){}};window.tpvOnLink=ok=>{if(db.kit.role!='caja')return;if(ok){KS.msg='Conectado, comprobando credenciales…';kUi()}else{KS.ok=false;if(!KS.noretry){KS.msg='Sin conexión con la cocina';clearTimeout(KS.tm);KS.tm=setTimeout(cConnect,5000)}kUi()}};
function kOut(id,o){if(window.TPVNative)TPVNative.send(id,JSON.stringify(o));else if(KS.bc)KS.bc.postMessage({to:id,m:o})}
function kBroad(){save();const act=db.coms.filter(c=>c.st!='servida');KS.auth.forEach(id=>kOut(id,{t:'coms',coms:act}));kUi()}
function kRecv(id,m){if(db.kit.role!='kitchen'||!m)return;
if(m.t=='hello'){if(m.pw===db.kit.pw){KS.auth.add(id);kOut(id,{t:'ok',coms:db.coms.filter(c=>c.st!='servida')})}else kOut(id,{t:'no'});return}
if(!KS.auth.has(id))return;
if(m.t=='send'&&m.com)kMerge(m.com);
else if(m.t=='note'){const c=db.coms.find(x=>x.id==m.id);if(c){c.note=String(m.note||'').slice(0,300);c.t1=Date.now();kBroad()}}
else if(m.t=='st'&&m.st=='servida'){const c=db.coms.find(x=>x.id==m.id);if(c){c.st='servida';c.t1=Date.now();kBroad()}}}
function kMerge(c){const now=Date.now();db.coms=db.coms.filter(x=>x.st!='servida'||now-x.t1<864e5);
let x=db.coms.find(o=>String(o.mesa)==String(c.mesa)&&o.st!='servida');
if(!x){x={id:db.cseq++,mesa:c.mesa,mname:'',waiter:String(c.waiter||''),t0:now,t1:now,items:[],note:'',st:'nueva'};db.coms.push(x)}
const old=Object.fromEntries(x.items.map(i=>[i.id,i]));
x.items=(c.items||[]).slice(0,100).map(i=>{const o=old[i.id],q=+i.q||1,nw=Math.max(0,q-(o?o.q:0));return{id:i.id,n:String(i.n).slice(0,80),q,nw:(o&&o.nw||0)+nw,ok:!!o&&o.ok&&!nw}});
x.note=String(c.note||'').slice(0,300);x.mname=String(c.mname||'').slice(0,40);x.t1=now;
if(x.items.some(i=>i.nw)&&x.st=='lista')x.st='prep';
beep();kBroad()}
function cConnect(){if(db.kit.role!='caja'||!db.kit.code)return;clearTimeout(KS.tm);KS.noretry=false;
if(db.kit.code=='prueba'&&navigator.userAgent.includes('; wv)')){KS.msg='El código «prueba» solo sirve entre pestañas de un navegador. Usa el código real de la cocina.';kUi();return}
if(db.kit.code=='prueba'){KS.bc=KS.bc||new BroadcastChannel('tpv-kitchen');KS.bc.onmessage=e=>{const d=e.data;if(d&&d.to==KS.cid)cRecv(d.m)};KS.link='bc';KS.msg='Conectando…';cSend({t:'hello',pw:db.kit.pw});return}
if(window.TPVNative&&TPVNative.clientSend){KS.link='tcp';KS.ok=false;KS.msg='Buscando la cocina…';TPVNative.connect(db.kit.host||'',db.kit.port||8080,db.kit.code,db.kit.pw||'');KS.tm=setTimeout(()=>{if(!KS.ok&&!KS.noretry)cConnect()},15000)}
else KS.msg='Falta actualizar el APK con el módulo de cocina nuevo';kUi()}
function cSend(o){if(KS.link=='tcp'&&window.TPVNative){if(TPVNative.clientSend(JSON.stringify(o)))return true;toast('Sin conexión con la cocina');return false}
if(KS.link=='bc'&&KS.bc){KS.bc.postMessage({from:KS.cid,m:o});return true}toast('Sin conexión con la cocina');return false}
function cRecv(m){if(m.t=='ok'){KS.ok=true;KS.msg='Cocina conectada';KS.coms=m.coms||[]}
else if(m.t=='no'){KS.ok=false;KS.noretry=true;KS.msg='Contraseña de cocina incorrecta';try{KS.link=='tcp'&&TPVNative.disconnect()}catch(e){}}
else if(m.t=='coms'){const pr=Object.fromEntries(KS.coms.map(c=>[c.id,c.st]));(m.coms||[]).forEach(c=>{if(c.st=='lista'&&pr[c.id]&&pr[c.id]!='lista'&&S.user&&c.waiter==S.user.name){toast('Mesa '+c.mesa+': comanda lista');beep()}});KS.coms=m.coms||[]}
kUi()}
function kInit(){if(db.kit.role=='kitchen'){S.kit=true;kStart();render()}else if(db.kit.role=='caja')cConnect();setInterval(()=>{if(S.kit)render()},30000)}
function kbtn(o,dis){if(db.kit.role!='caja')return'';const c=o?KS.coms.find(x=>String(x.mesa)==String(o.num)&&x.st!='servida'):null;
return `<p class="mut" style="margin:0 0 8px">Cocina: ${KS.ok?'conectada':esc(KS.msg||'sin conexión')}${c?' · '+stN[c.st]:''}</p><button class="b sec" style="margin-bottom:8px" data-a="ksend" ${dis}>${c?'Actualizar comanda':'Enviar a cocina'}</button>${c&&c.st=='lista'?'<button class="b big" data-a="kserv" data-v="'+c.id+'">Marcar como servida</button>':''}`}
function kcard(c){const mins=Math.round((Date.now()-c.t0)/60000),nx={nueva:['prep','Empezar'],prep:['lista','Lista'],lista:['servida','Servida']}[c.st];
return `<div class="kc ${c.st}"><div class="kh"><b>Mesa ${esc(c.mesa)}${c.mname?' · '+esc(c.mname):''}</b><span>${hm(c.t0)} · ${mins} min</span></div><small>${esc(c.waiter)} · ${stN[c.st]}</small>${c.items.map(i=>`<div class="kl ${i.ok?'dn':''}"><button data-a="kok" data-v="${c.id}|${i.id}"><b>${i.q}×</b> ${esc(i.n)}${i.nw?`<em>+${i.nw} NUEVO</em>`:''}</button><span><button data-a="kq" data-v="${c.id}|${i.id}|-1">−</button><button data-a="kq" data-v="${c.id}|${i.id}|1">+</button></span></div>`).join('')}<button class="kn" data-a="knote" data-v="${c.id}">${c.note?'📝 '+esc(c.note):'📝 Añadir nota'}</button><button class="b big" style="margin:0" data-a="kst" data-v="${c.id}|${nx[0]}">${nx[1]}</button></div>`}
function kitchen(){const l=db.coms.filter(c=>c.st!='servida');return `<header><b class="br">Cocina · ${esc(db.biz.name)}</b><span class="us">${esc(KS.msg)}</span><nav><button class="b" data-a="kadm">Administración</button></nav></header><main><div class="kg">${l.map(kcard).join('')||'<p class="mut">No hay comandas pendientes.</p>'}</div></main>`}
const kf=v=>{const p=String(v).split('|'),c=db.coms.find(x=>x.id==p[0]);return[c,c&&c.items.find(i=>i.id==p[1]),+p[2]]};
const A={
login(v){const x=db.users.find(u=>u.id==v);if(x.np&&x.role=='cam'){S.user=x;S.view='caja';render();return}S.sel=+v;S.pin='';S.err='';render()},back(){S.sel=null;render()},
pk(v){if(v=='⌫')S.pin=S.pin.slice(0,-1);else if(v=='Entrar'){const x=db.users.find(u=>u.id==S.sel);if(x.pin==S.pin){S.user=x;S.view='caja';S.sel=null;S.pin='';S.err=''}else{S.err='PIN incorrecto';S.pin=''}}else if(S.pin.length<4)S.pin+=v;render()},
out(){S.user=null;S.cur=null;S.sel=null;render()},view(v){S.view=v;render()},cat(v){S.cat=v;render()},sw(v){S.cur=v;const o=db.orders[v];if(o)o.pend=false;save();render()},
pend(){const o=db.orders[S.cur];if(!o)return;o.pend=true;S.cur=null;save();render();toast('Cuenta de la mesa '+o.num+' pendiente. Selecciónala para seguir.')},
prod(v){if(S.cur==null){S.after=v;A.mesa();return}addItem(v);render()},
pl(k){db.orders[S.cur].items[k].q++;save();render()},mn(k){const i=db.orders[S.cur].items;i[k].q--;if(i[k].q<=0)i.splice(k,1);save();render()},
mesa(){const o=db.orders[S.cur];modal(`<h2>Elegir mesa</h2><label>Nombre de la mesa (opcional)<input id="mn" value="${esc(o?o.name:'')}" placeholder="Terraza, barra…"></label><div class="mesas">${db.mesas.map(n=>`<button class="${db.orders[n]?'oc':''}" data-a="pickm" data-v="${esc(n)}">${esc(n)}</button>`).join('')}</div><button class="lnk" data-a="closeM">Cancelar</button>`)},
pickm(v){openOrder(v,$('#mn').value.trim());if(S.after){addItem(S.after);S.after=null}closeM();render()},
clear(){if(confirm('¿Vaciar la cuenta de esta mesa?')){delete db.orders[S.cur];S.cur=null;save();render()}},
cobrar(){S.pend=null;custM(true)},later(){custM(false)},pay(v){const c=cust();if(c)finish(true,v,c)},lat(){const c=cust();if(c)finish(false,'',c)},
fl(v){S.filter=v;render()},tick(v){showTick(v)},cobh(v){S.pend=v;payM(f(db.hist.find(r=>r.id==v).total))},
payh(v){const r=db.hist.find(x=>x.id==S.pend);r.paid=true;r.method=v;S.pend=null;save();setTimeout(()=>doSync(true),300);closeM();render();toast('Cuenta cobrada')},
closeM,async print(v){const r=db.hist.find(x=>x.id==v);if(db.pr.mode=='bt'){try{if(!BT.ch||!BT.dev.gatt.connected)await btConnect();await btSend(escpos(r));toast('Enviado a la impresora')}catch(e){toast(e.message||'No se pudo imprimir por Bluetooth')}return}$('#print').innerHTML=tkHTML(r);window.print()},
btc(){btConnect().then(()=>{toast('Impresora conectada');render()}).catch(e=>toast(e.message||'No se pudo conectar'))},
btt(){(async()=>{try{if(!BT.ch||!BT.dev.gatt.connected)await btConnect();await btSend(escpos(sample()));toast('Prueba enviada')}catch(e){toast(e.message||'Error')}})()},
kbt(){S.kb=!S.kb;kbShow(S.kb&&S.ae);render()},set(v){S.set=v;if(v=='sy'&&db.sync.prov=='google')gLoad().catch(()=>{});render()},
uadd(){const n=$('#un').value.trim(),p=$('#up').value.trim(),np=$('#un2').checked&&$('#ur').value=='cam';if(!n||(!np&&!/^\d{4}$/.test(p))){toast('Escribe un nombre y un PIN de 4 cifras');return}db.users.push({id:db.uid++,name:n,role:$('#ur').value,pin:np?'':p,np});save();render()},
udel(v){const u=db.users.find(x=>x.id==v);if(u.id==S.user.id){toast('No puedes eliminar tu propio usuario');return}if(u.role=='admin'&&db.users.filter(x=>x.role=='admin').length<2){toast('Debe quedar un administrador');return}db.users=db.users.filter(x=>x.id!=v);save();render()},
padd(){const n=$('#pn').value.trim();if(!n)return toast('Escribe el nombre del producto');db.prods.push({id:db.pid++,n,p:num($('#pp').value),c:$('#pc').value});save();render()},
pdel(v){db.prods=db.prods.filter(x=>x.id!=v);save();render()},
cadd(){const n=$('#cn').value.trim();if(n&&!db.cats.includes(n)){db.cats.push(n);save();render()}},
cdel(v){if(confirm('¿Eliminar la categoría '+v+' y sus productos?')){db.cats=db.cats.filter(x=>x!=v);db.prods=db.prods.filter(p=>p.c!=v);save();render()}},
madd(){const m=$('#mt').value.trim();if(!m||db.mesas.includes(m))return toast('Escribe una mesa que no exista');db.mesas.push(m);save();render()},
mdel(v){if(db.orders[v])return toast('Esa mesa tiene una cuenta abierta');db.mesas=db.mesas.filter(x=>x!=v);save();render()},
lgdel(){delete db.biz.logo;save();render()},
theme(v){db.theme=v;save();applyTheme();render()},
kok(v){const[c,i]=kf(v);if(!i)return;i.ok=!i.ok;if(i.ok)i.nw=0;kBroad()},
kq(v){const[c,i,d]=kf(v);if(!i)return;i.q+=d;i.nw=Math.min(i.nw||0,Math.max(i.q,0));if(i.q<=0)c.items=c.items.filter(x=>x!==i);if(!c.items.length)c.st='servida';c.t1=Date.now();kBroad()},
kst(v){const p=v.split('|'),c=db.coms.find(x=>x.id==p[0]);if(!c)return;c.st=p[1];c.items.forEach(i=>{i.nw=0});c.t1=Date.now();kBroad()},
knote(v){const c=db.coms.find(x=>x.id==v);if(!c)return;modal(`<h2>Nota de la comanda · Mesa ${esc(c.mesa)}</h2><label>Nota<input id="kn2" value="${esc(c.note)}"></label><button class="b big" data-a="knsave" data-v="${c.id}">Guardar</button><button class="lnk" data-a="closeM">Cancelar</button>`);setTimeout(()=>$('#kn2').focus(),60)},
knsave(v){const c=db.coms.find(x=>x.id==v);if(c){c.note=$('#kn2').value.trim().slice(0,300);c.t1=Date.now();closeM();kBroad()}},
kadm(){modal(`<h2>Administración</h2><label>PIN de administrador<input id="ka" type="password" inputmode="numeric" maxlength="4"></label><button class="b big" data-a="kadmok">Entrar</button><button class="lnk" data-a="closeM">Cancelar</button>`);setTimeout(()=>$('#ka').focus(),60)},
kadmok(){if(!admOk($('#ka').value))return toast('PIN incorrecto');closeM();S.kit=false;render()},
kback(){S.kit=true;render()},
kmodal(){const r=db.kit.role;modal(`<h2>Conexión de cocina</h2><p class="mut">Módulo nativo de cocina: <b>${window.TPVNative&&TPVNative.clientSend?'detectado ✔ · IP de esta tablet: '+esc(TPVNative.getIp()):'NO detectado'}</b></p><p class="mut">${r=='kitchen'?'Este dispositivo es la cocina.':r=='caja'?'Conectado con la cocina: '+esc(db.kit.code)+' · '+esc(KS.msg):'Sin configurar.'}</p>
<h2 style="margin-top:14px">Conectar este dispositivo con la cocina</h2><label>Código de la cocina<input id="kh" value="${esc(r=='caja'?db.kit.code:'')}" placeholder="Código de la cocina"></label><label>Dirección IP de la cocina (opcional)<input id="ki" value="${esc(r=='caja'?db.kit.host:'')}" placeholder="Solo si no la encuentra sola"></label><label>Contraseña de cocina<input id="kp" type="password"></label><button class="b big" data-a="kcon">Conectar</button>
<h2 style="margin-top:14px">Este dispositivo es la cocina</h2><label>PIN de administrador<input id="ka" type="password" inputmode="numeric" maxlength="4"></label><label>Código de la cocina (nuevo)<input id="kc" value="${esc(r=='kitchen'?db.kit.code:'')}" inputmode="numeric"></label><label>Contraseña de cocina (nueva)<input id="kw" type="password"></label><button class="b big" data-a="kact">Activar pantalla de cocina</button>
${r?'<button class="lnk" data-a="kquit">Quitar la configuración de cocina (pide el PIN de administrador en la cocina)</button>':''}<button class="lnk" data-a="closeM">Cerrar</button>`)},
kcon(){const code=$('#kh').value.trim(),host=$('#ki').value.trim(),pw=$('#kp').value;if(!code||!pw)return toast('Escribe el código y la contraseña de la cocina');
db.kit={role:'caja',code,host,port:8080,pw};save();KS.coms=[];KS.ok=false;cConnect();closeM();toast('Conectando con la cocina…')},
kact(){const pw=$('#kw').value.trim(),code=$('#kc').value.trim();if(!admOk($('#ka').value))return toast('PIN de administrador incorrecto');if(!code)return toast('Escribe un código para la cocina');if(pw.length<4)return toast('La contraseña de cocina debe tener al menos 4 caracteres');
KS.noretry=true;try{window.TPVNative&&TPVNative.disconnect&&TPVNative.disconnect()}catch(e){}db.kit={role:'kitchen',pw,host:'',port:8080,code};save();S.kit=true;kStart();closeM();render()},
kquit(){if(db.kit.role=='kitchen'&&!admOk($('#ka').value))return toast('Escribe el PIN de administrador');
try{window.TPVNative&&TPVNative.stopServer()}catch(e){}try{window.TPVNative&&TPVNative.disconnect&&TPVNative.disconnect()}catch(e){}KS.noretry=true;db.kit={role:'',pw:'',host:'',port:8080,code:''};KS.ok=false;KS.msg='';S.kit=false;save();closeM();render()},
ksend(){const o=db.orders[S.cur];if(!o||!o.items.length)return;modal(`<h2>Enviar a cocina · Mesa ${esc(o.num)}</h2><label>Nota para cocina<input id="kn3" value="${esc(o.note||'')}" placeholder="Sin cebolla, alergias…"></label><button class="b big" data-a="ksgo">Enviar</button><button class="lnk" data-a="closeM">Cancelar</button>`);setTimeout(()=>$('#kn3').focus(),60)},
ksgo(){const o=db.orders[S.cur];o.note=$('#kn3').value.trim().slice(0,300);save();if(cSend({t:'send',com:{mesa:o.num,mname:o.name,waiter:o.waiter,items:o.items.map(i=>({id:i.id,n:i.n,q:i.q})),note:o.note}})){closeM();toast('Enviado a cocina')}},
kserv(v){cSend({t:'st',id:+v,st:'servida'})},
upgo(){try{if(!UP)return;localStorage.setItem('tpv_upd',JSON.stringify({ver:UP.ver,html:UP.html}));location.reload()}catch(e){closeM();toast(e.name=='QuotaExceededError'?'No hay espacio para guardar la actualización':e.message)}},
updchk(){updCheck(false)},
updrop(){if(confirm('¿Volver a la versión original instalada?')){try{localStorage.removeItem('tpv_upd')}catch(e){}location.reload()}},
syc(){const y=db.sync;if(!y.prov)return toast('Elige primero un servicio');
if(y.prov=='google'){if(!y.gid)return toast('Escribe el ID de cliente de Google');gToken().then(()=>doSync(false)).catch(e=>toast(e.message))}
else{if(!y.mid)return toast('Escribe el ID de cliente de Microsoft');msStart()}},
syn(){doSync(false)},
bkx(){shareFile('tickets-'+new Date().toISOString().slice(0,10)+'.json',{t:'tickets',hist:db.hist}).then(ok=>{if(ok){db.lastBk=new Date().toISOString();save();render();toast('Copia guardada')}})},
tux(){const u=db.users.find(x=>x.id==$('#tu').value),mv=$('#tm').checked;
if(mv&&(u.id==S.user.id||(u.role=='admin'&&db.users.filter(x=>x.role=='admin').length<2)))return toast('No puedes quitar a este usuario');
if(mv&&Object.values(db.orders).some(o=>o.waiter==u.name))return toast('Cierra antes sus mesas abiertas');
shareFile('usuario-'+u.name.replace(/\W+/g,'_')+'.json',{t:'usuario',user:{name:u.name,role:u.role,pin:u.pin,np:u.np},hist:db.hist.filter(r=>r.waiter==u.name)}).then(ok=>{if(!ok)return;if(mv){db.users=db.users.filter(x=>x.id!=u.id);db.hist=db.hist.filter(r=>r.waiter!=u.name);save();render()}toast('Usuario exportado')})}};
document.addEventListener('change',e=>{const el=e.target;if(!['bki','tui'].includes(el.id)||!el.files[0])return;el.files[0].text().then(tx=>{let d;try{d=JSON.parse(tx)}catch(x){return toast('El archivo no es válido')}
if(!d||!Array.isArray(d.hist)||d.t!=(el.id=='bki'?'tickets':'usuario'))return toast('Ese archivo no corresponde a esta opción');
const have=new Set(db.hist.map(r=>r.id));let n=0;d.hist.forEach(r=>{if(!r||typeof r.d!='string'||!Array.isArray(r.items))return;r.id=r.id||r.d+'|'+r.no+'|'+r.waiter;if(!have.has(r.id)){db.hist.push(r);have.add(r.id);n++}});db.hist.sort((a,b)=>b.d.localeCompare(a.d));
let m='';const u=d.user;if(d.t=='usuario'&&u&&u.name&&!db.users.some(x=>x.name==u.name)){db.users.push({id:db.uid++,name:String(u.name),role:u.role=='admin'?'admin':'cam',pin:/^\d{4}$/.test(u.pin)?u.pin:'0000',np:!!u.np&&u.role!='admin'});m=' y usuario añadido'}
save();render();toast(n+' tickets importados'+m)})});
document.addEventListener('change',e=>{if(e.target.id!='lg'||!e.target.files[0])return;const fr=new FileReader();fr.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,400/im.width),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);db.biz.logo=c.toDataURL('image/png');save();render()};im.src=fr.result};fr.readAsDataURL(e.target.files[0])});
document.addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(b)A[b.dataset.a](b.dataset.v)});
document.addEventListener('input',e=>{const el=e.target;
if(el.dataset.k){let v=el.type=='checkbox'?el.checked:el.dataset.n?num(el.value):el.value;setp(db,el.dataset.k,v);save();const pv=$('#pv');if(pv)pv.innerHTML=tkHTML(sample())}
else if(el.dataset.l){const x=db[el.dataset.l].find(i=>i.id==el.dataset.id),fl=el.dataset.f;
if(fl=='role'&&x.role=='admin'&&el.value!='admin'&&db.users.filter(u=>u.role=='admin').length<2){toast('Debe quedar un administrador');render();return}
x[fl]=el.type=='checkbox'?el.checked:el.dataset.n?num(el.value):el.value;if(fl=='role'&&el.value=='admin')x.np=false;save();if(fl=='role')render()}});
// Teclado táctil
const R=[['1','2','3','4','5','6','7','8','9','0'],['q','w','e','r','t','y','u','i','o','p'],['a','s','d','f','g','h','j','k','l','ñ'],['⇧','z','x','c','v','b','n','m','⌫']];
function kbDraw(){$('#kb').innerHTML=R.map(r=>`<div class="kr">${r.map(k=>`<button data-key="${k}">${S.sh&&k.length==1?k.toUpperCase():k}</button>`).join('')}</div>`).join('')+`<div class="kr"><button class="wd" data-key="cerrar">Cerrar</button><button data-key=",">,</button><button class="sp" data-key=" ">Espacio</button><button data-key=".">.</button><button class="wd" data-key="tab">Siguiente</button></div>`}
function kbShow(on){const k=$('#kb');k.style.display=on?'block':'none';document.body.style.paddingBottom=on?k.offsetHeight+'px':'';if(on)kbDraw()}
$('#kb').addEventListener('mousedown',e=>e.preventDefault());
$('#kb').addEventListener('click',e=>{const b=e.target.closest('[data-key]');if(!b)return;let k=b.dataset.key,el=S.ae;
if(k=='⇧'){S.sh=!S.sh;kbDraw();return}if(k=='cerrar'){kbShow(false);return}
if(!el)return;el.focus();
if(k=='tab'){const all=[...document.querySelectorAll('#mod input,#app input:not([type=checkbox])')],i=all.indexOf(el);(all[i+1]||all[0]).focus();return}
let s=el.selectionStart??el.value.length,en=el.selectionEnd??s;
if(k=='⌫'){if(s==en&&s>0)s--;el.setRangeText('',s,en,'end')}else{el.setRangeText(S.sh&&k.length==1?k.toUpperCase():k,s,en,'end');if(S.sh){S.sh=false;kbDraw()}}
el.dispatchEvent(new Event('input',{bubbles:true}))});
document.addEventListener('focusin',e=>{const el=e.target;if(el.tagName=='INPUT'&&!['checkbox','file'].includes(el.type)){S.ae=el;if(S.kb){el.setAttribute('inputmode','none');kbShow(true)}}});
applyTheme();render();syncInit();kInit();setTimeout(()=>updCheck(true),8000);setInterval(()=>updCheck(true),21600000);
}
</script></body></html>
